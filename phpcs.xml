<?xml version="1.0"?>
<ruleset name="WP Mail DKIM Sign Standards">
	<description>WordPress Coding Standards for the wpmail-dkim-sign plugin.</description>

	<file>.</file>

	<!-- Exclude patterns -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/.git/*</exclude-pattern>
	<exclude-pattern>*/.github/*</exclude-pattern>
	<exclude-pattern>*/dev-notes/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<!-- Arguments -->
	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- Minimum WordPress version targeted -->
	<config name="minimum_supported_wp_version" value="6.2"/>

	<!-- Rules -->
	<rule ref="WordPress">
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>

		<!-- An if with elseif branches ends in an explicit else, with no-op branches
		     holding only a comment. This sniff counts a comment as
		     empty, so only its if/elseif/else codes are excluded; empty catch, loop and
		     switch bodies are still errors. -->
		<exclude name="Generic.CodeAnalysis.EmptyStatement.DetectedIf"/>
		<exclude name="Generic.CodeAnalysis.EmptyStatement.DetectedElseif"/>
		<exclude name="Generic.CodeAnalysis.EmptyStatement.DetectedElse"/>
	</rule>

	<!--
		Prefix allow-list:
		- `WPMail_DKIM_Sign` — namespace for class code
		- `wpdkm` / `WPDKM` — short prefix for everything in the global PHP
		  namespace (define() constants, root functions) and for external
		  identifiers stored as strings (wp_options keys, admin-post action
		  names, nonce names, transient keys).
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="WPMail_DKIM_Sign"/>
				<element value="wpdkm"/>
				<element value="WPDKM"/>
			</property>
		</properties>
	</rule>

	<!-- Text domain validation -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wpmail-dkim-sign"/>
			</property>
		</properties>
	</rule>

	<!--
		PHPMailer property allow-list. PHPMailer (in WordPress core) exposes
		public properties in PascalCase / camelCase, not snake_case — we
		cannot rename them. Whitelist the specific properties we touch on
		PHPMailer instances so the snake_case sniff stops flagging them.
	-->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<properties>
			<property name="allowed_custom_properties" type="array">
				<element value="From"/>
				<element value="DKIM_domain"/>
				<element value="DKIM_selector"/>
				<element value="DKIM_private_string"/>
				<element value="DKIM_identity"/>
				<element value="DKIM_passphrase"/>
				<element value="DKIM_copyHeaderFields"/>
			</property>
		</properties>
	</rule>
</ruleset>
